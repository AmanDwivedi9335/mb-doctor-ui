{
  "name": "medibank-doctor-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "dev": "pnpm --filter @myanodex/doctor dev",
    "build": "pnpm --filter @myanodex/doctor build",
