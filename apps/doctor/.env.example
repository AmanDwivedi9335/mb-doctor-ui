# Doctor portal build-time env. Copy to .env for local overrides.

# Backend origin for a deployed build. Leave unset in dev: the vite proxy
# forwards /api to VITE_BACKEND_ORIGIN so requests stay same-origin.
# VITE_API_ORIGIN=https://api.medibank.in

# Dev only: where the vite proxy forwards /api (the local rig).
# VITE_BACKEND_ORIGIN=http://localhost:3000

# Set to "true" to run on the MSW fixtures instead of a backend.
# VITE_ENABLE_MOCKS=true
